# ─── DATABASE ────────────────────────────────────────────────────────────────
# Production runs on Supabase Postgres. Two URLs are required:
#   DATABASE_URL — pooled (PgBouncer, port 6543). Used by the app at runtime.
#   DIRECT_URL   — direct (port 5432). Used by `prisma db push` / `migrate`,
#                  which cannot run through a transaction pooler.
# Both are in Supabase → Project Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Local alternative: `docker compose up -d` then point both at local Postgres.
# DATABASE_URL="postgresql://tatavera_user:tatavera_dev@localhost:5432/tatavera_health?schema=public"
# DIRECT_URL="postgresql://tatavera_user:tatavera_dev@localhost:5432/tatavera_health?schema=public"

# Password for the demo accounts created by `npm run db:seed`.
SEED_DEMO_PASSWORD="change-this-before-you-seed-production"

# ─── AUTH ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this"

# Local / testing (optional):
# AUTH_DEV_OTP=1           — treat email as optional for 2FA; always log OTP to server console
# AUTH_RETURN_OTP=1        — always include debugOtp in /api/auth/login JSON (even with next start)
# AUTH_HIDE_DEBUG_OTP=1    — never put debugOtp in JSON (real production)

# ─── AWS S3 (Patient Report Storage) ─────────────────────────────────────────
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="tatavera-patient-reports"

# ─── EMAIL (signup + login 2FA OTP) ───────────────────────────────────────────
# Resend (free): https://resend.com — create API key; dev can use from: onboarding@resend.dev
RESEND_API_KEY="re_xxxxxxxx"
FROM_EMAIL="Tatvavera Health <onboarding@resend.dev>"
# Or any SMTP (Gmail app password, etc.):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="app-password"
# FROM_EMAIL="you@gmail.com"

# ─── AI CHATBOT (Aria) ───────────────────────────────────────────────────────
# Free key at https://aistudio.google.com/apikey — generous free tier
GEMINI_API_KEY="AIza..."

# Legacy / other
SENDGRID_API_KEY="SG.your-sendgrid-key"
ADMIN_EMAIL="care@tataverahealth.com"

# ─── SMS / OTP (Phone tab on login — optional; trial at https://www.twilio.com) ─
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"

# ─── CRM ──────────────────────────────────────────────────────────────────────
HUBSPOT_API_KEY="your-hubspot-key"

# ─── ANALYTICS ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_HOTJAR_ID="1234567"

# ─── SITE ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://tataverahealth.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="+919999999999"

# ─── ENV ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"

# Email-code 2FA on login is OFF by default. Set to 1 to require it.
# AUTH_REQUIRE_2FA=1
